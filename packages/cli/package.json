{
  "name": "@slicemedia/devkit-cli",
  "version": "0.5.0",
  "private": false,
  "description": "Build local project bundles and inspect Webflow state with Slice Media DevKit.",
  "author": "Slice Media",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/slicemedia/devkit.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/slicemedia/devkit/tree/main/packages/cli#readme",
  "bugs": {
    "url": "https://github.com/slicemedia/devkit/issues"
  },
  "keywords": [
    "slicemedia",
    "webflow",
    "cli",
    "vite",
    "typescript"
  ],
  "license": "MIT",
  "type": "module",
  "bin": {
    "slicemedia-devkit": "./bin/slicemedia-devkit.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "bin",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.13.0 <23 || >=24.0.0 <25"
  },
  "scripts": {
    "build": "node scripts/prepare-build.mjs && tsc -p tsconfig.build.json && node scripts/finalize-build.mjs",
    "test": "vitest run src",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "vite": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
